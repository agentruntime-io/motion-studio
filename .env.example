# PostHog (optional — analytics disabled when unset)
# Create a project at https://posthog.com and paste the Project API Key here.
VITE_POSTHOG_KEY=

# EU cloud (default for this project). Use https://us.i.posthog.com for US.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Set to true to send analytics while running npm run dev
# VITE_POSTHOG_DEV=true
